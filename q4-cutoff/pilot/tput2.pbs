#!/bin/bash
#PBS -A <project>
#PBS -q debug
#PBS -l select=2:system=polaris
#PBS -l walltime=00:40:00
#PBS -l filesystems=home:grand
#PBS -N q4-tput2
#PBS -j oe
#PBS -o $WORK/consensus/q4-cutoff/logs/
# Q4 throughput pilot, 2 nodes x 4 A100: inter-node scaling for d26 and d34. Uses tokenizer from tput1.
set -x
Q4=$WORK/consensus/q4-cutoff
export http_proxy=http://proxy.alcf.anl.gov:3128 https_proxy=http://proxy.alcf.anl.gov:3128
export HF_HOME=$Q4/hf OMP_NUM_THREADS=8
export CC=/usr/bin/gcc-14 CXX=/usr/bin/g++-14  # triton JIT; default PrgEnv cc is nvc
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
LS=/local/scratch; [ -d $LS ] || LS=/tmp
export NANOCHAT_BASE_DIR=$LS/nc_base_q4
mpiexec -n 2 --ppn 1 bash -c "mkdir -p $NANOCHAT_BASE_DIR && cp -r $Q4/nc_base/base_data_climbmix $NANOCHAT_BASE_DIR/ && mkdir -p $NANOCHAT_BASE_DIR/tokenizer && cp $Q4/tokenizer_pilot/* $NANOCHAT_BASE_DIR/tokenizer/"
# Slingshot NCCL via aws-ofi-nccl (ALCF recipe)
export LD_LIBRARY_PATH=/soft/libraries/aws-ofi-nccl/v1.9.1-aws/lib:/soft/libraries/hwloc/lib:/opt/cray/libfabric/2.3.1/lib64:$LD_LIBRARY_PATH
export NCCL_NET_GDR_LEVEL=PHB NCCL_CROSS_NIC=1 NCCL_COLLNET_ENABLE=1 NCCL_NET="AWS Libfabric"
export FI_CXI_DISABLE_HOST_REGISTER=1 FI_MR_CACHE_MONITOR=userfaultfd FI_CXI_DEFAULT_CQ_SIZE=131072
export NCCL_DEBUG=INFO NCCL_DEBUG_SUBSYS=INIT,NET
export MASTER_ADDR=$(head -1 $PBS_NODEFILE) MASTER_PORT=29511
cd $Q4/nanochat && source .venv/bin/activate
run() { # depth iters device_batch
  mpiexec -n 8 --ppn 4 --cpu-bind depth -d 16 --env MASTER_ADDR=$MASTER_ADDR --env MASTER_PORT=$MASTER_PORT \
    bash -c 'export RANK=$PMI_RANK LOCAL_RANK=$PMI_LOCAL_RANK WORLD_SIZE=$PMI_SIZE; exec python -m scripts.base_train --depth='$1' --num-iterations='$2' --device-batch-size='$3' --total-batch-size=524288 --eval-every=-1 --core-metric-every=-1 --sample-every=-1 --run=dummy --model-tag=pilot2n_d'$1 \
    2>&1 | grep -v "^W1\|Warning" | tee $Q4/logs/tput2_d$1_$PBS_JOBID.log
}
run 26 30 4
run 34 25 2
echo END $(date)
